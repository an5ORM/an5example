model User {
  id        TEXT     @id @default(uuid()) @description("Primary key for the User table (auto-generated UUID)")
  email     VARCHAR(255)  @unique @description("Unique email address used for login and notifications")
  name      VARCHAR(255)? @description("Display name of the user")
  isActive  BOOLEAN  @default(true) @description("Whether the user account is active")
  score     INTEGER  @default(0) @description("Accumulated score used in aggregation examples")
  embedding VECTOR(3)?   @description("Embedding vector for the semantic-search example")
  createdAt DATETIME @default(now()) @description("Timestamp when the user profile was created")
  orders    Order[]

  @@description("Represents a registered user in the database.")
}
