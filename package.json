{
  "name": "an5-example",
  "version": "0.1.0",
  "private": true,
  "description": "Example usage and integration tests for AN5 ORM - schema, generated clients (TypeScript/Go/.NET/Python), all adapter dialects, and browser support.",
  "license": "MIT",
  "scripts": {
    "generate": "node ../an5Orm/dist/generator/src/index.js",
    "db:setup": "npx tsx scripts/db-setup.ts",
    "build": "npx tsc -p tsconfig.json",
    "test": "npm run build && npm run test:suite && npm run test:browser && npm run test:example:ts && npm run test:go && npm run test:dotnet && npm run test:example:dotnet && npm run test:python",
    "test:suite": "node test/crud.sqlite.test.js",
    "test:live": "node test/crud.live.test.js",
    "test:browser": "node test/crud.browser.test.js && node test/browser-bundle.test.js",
    "test:example:ts": "node dist/examples/typescript/crud.js",
    "test:example:go": "npm --prefix examples/golang exec -- go run .",
    "test:example:dotnet": "dotnet run --project examples/dotnet",
    "test:go": "node test/go-example-build.js",
    "test:dotnet": "node test/dotnet-compile-check.js",
    "test:python": "python -m compileall -q examples/python && python examples/python/crud.py"
  },
  "devDependencies": {
    "@an5/adapters": "file:../an5Adapters",
    "@an5/orm": "file:../an5Orm",
    "an5-client": "file:../an5Client",
    "better-sqlite3": "^12.4.1",
    "esbuild": "^0.28.2",
    "sql.js": "^1.14.2",
    "typescript": "^6.0.3"
  }
}
