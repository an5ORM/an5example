<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven manifest for the AN5 Java example.

  The example lives in three places at once: its own sources, the generated client, and the
  JDBC runtime. None of them is published as an artifact yet, so rather than pretending they
  are, `build-helper` adds the two sibling source trees and the build compiles all three
  together — which is what a consumer gets from `mvn package` once `an5-adapters-java` is on
  a repository.

  The only dependency is the SQLite driver: the runtime speaks `java.sql` and deliberately
  brings no driver of its own, so the example names the one it runs against.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.an5orm</groupId>
  <artifactId>an5-example-java</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>

  <name>AN5 ORM Java example</name>
  <description>CRUD and relation example over the generated AN5 Java client.</description>
  <url>https://github.com/an5ORM/an5example</url>
  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>

  <properties>
    <!--
      Java 8 bytecode, not the JDK in use, for the same reason the runtime does it: the
      example has to stay buildable in the environments the runtime targets, Android first.
    -->
    <maven.compiler.release>8</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <exec.mainClass>an5.example.CrudExample</exec.mainClass>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>3.46.1.3</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <sourceDirectory>src/main/java</sourceDirectory>
    <plugins>
      <!--
        The generated client and the runtime are source trees in this repository, not
        artifacts. Adding them here keeps `mvn compile` honest about what the example is
        actually compiled against instead of a stub classpath.
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>add-an5-sources</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>../../generated/java</source>
                <source>../../../an5Adapters/java/src/main/java</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
      </plugin>
    </plugins>
  </build>
</project>
